# Copy to .env.local for local development. Never commit real values.

# PostgreSQL connection string (local: started by `pnpm db:start`; prod: Neon)
DATABASE_URL=postgres://postgres@localhost:54329/placebook

# Password gate (Phase 1). Use a long random value in production.
APP_PASSWORD=change-me
# At least 32 random characters, used to sign the session cookie.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Place matching: google | nominatim
GEOCODING_PROVIDER=google
# Server-side only. Never expose to the browser.
GOOGLE_MAPS_API_KEY=
# Optional: User-Agent for the public Nominatim instance (its policy asks
# for one that identifies the app).
NOMINATIM_USER_AGENT=
